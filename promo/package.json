{
  "name": "spotivibe-promo",
  "version": "1.0.0",
  "private": true,
  "description": "60-second motion-graphics promo for Spotivibe, rendered with Remotion",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "score": "node scripts/score/generate.mjs",
    "prepare-all": "npm run assets && npm run score",
    "studio": "remotion studio src/index.ts",
    "test": "node --test \"test/**/*.test.*\"",
    "typecheck": "tsc --noEmit",
    "check-frames": "node scripts/check-frames.mjs",
    "render": "remotion render src/index.ts SpotivibePromo out/spotivibe-promo.mp4",
    "build": "npm run prepare-all && npm run render && npm run render:fictional",
    "catalog": "node scripts/catalog/fetch-catalog.mjs",
    "render:fictional": "remotion render src/index.ts SpotivibePromo out/spotivibe-promo-fictional.mp4 --env-file=env/fictional.env",
    "eval": "node scripts/eval-render.mjs out/spotivibe-promo.mp4 && node scripts/eval-render.mjs out/spotivibe-promo-fictional.mp4",
    "social": "node scripts/social-preview.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "kuromoji": "0.1.2",
    "pinyin-pro": "3.29.5",
    "typescript": "5.7.2"
  }
}
