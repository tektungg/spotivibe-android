# Template untuk keystore.properties — JANGAN commit yang asli ke git.
# Copy file ini jadi keystore.properties (di root project) dan isi value real.
#
# storeFile di-resolve lewat rootProject.file(), jadi path-nya relatif terhadap
# ROOT project (folder yang berisi settings.gradle.kts), bukan terhadap app/.
# Untuk keystore di root, tulis "release.jks" saja tanpa "../".
storeFile=release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=spotivibe
keyPassword=YOUR_KEY_PASSWORD
