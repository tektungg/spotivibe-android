<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access untuk sumber lirik (LRCLIB, AMLL, lrc.red, LRCMux) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Status jaringan untuk mode offline (NetworkMonitor). Tanpa ini
         registerDefaultNetworkCallback melempar SecurityException, monitor
         jatuh ke "selalu online", dan offline kembali menunggu timeout tiap
         ganti lagu. Permission normal, tidak butuh grant runtime. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service untuk lyrics notification (specialUse — bukan media
         player karena app lain yang memutar musik, kita cuma companion display) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Runtime notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Floating overlay di atas app lain (Phase 7) — user grant via system Settings -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Haptic tick saat baris lirik berganti. Tanpa ini Vibrator.vibrate()
         melempar SecurityException, dan runCatching di Haptics.tick menelannya,
         jadi setelan haptic di Settings diam-diam tidak pernah bekerja.
         Permission normal, tidak butuh grant runtime. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Supaya nama app player ("YouTube Music") bisa dibaca di Android 11+.
         Tanpa ini getApplicationInfo() untuk paket lain gagal karena package
         visibility, dan UI cuma bisa menampilkan nama paket. Semua player
         musik mengekspos MediaBrowserService. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".SpotivibeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spotivibe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Spotivibe"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- FileProvider untuk share lyric-card sebagai PNG ke other apps.
             Authority pakai BuildConfig.APPLICATION_ID supaya unik per build. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Foreground lyrics notification service. Type "specialUse" supaya
             system tidak claim sebagai media player + tidak membajak indikator
             media milik player di lock screen. -->
        <service
            android:name=".service.SpotivibeNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Display synced lyrics of the media currently playing in any music app" />
        </service>

        <!-- Kunci untuk membaca MediaSession app lain (getActiveSessions).
             Kelasnya kosong; sistem yang mengikatnya setelah user mengaktifkan
             Spotivibe di Settings → Notification access. Permission BIND_*
             wajib: tanpanya app lain mana pun bisa mengikat service ini. -->
        <service
            android:name=".service.SessionAccessService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
