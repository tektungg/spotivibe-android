<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for LRCLIB + Spotify Web API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Status jaringan untuk mode offline (NetworkMonitor). Tanpa ini
         registerDefaultNetworkCallback melempar SecurityException, monitor
         jatuh ke "selalu online", dan offline kembali menunggu timeout tiap
         ganti lagu. Permission normal, tidak butuh grant runtime. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service untuk lyrics notification (specialUse — bukan media
         player karena Spotify yang main musik, kita cuma companion display) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Runtime notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Floating overlay di atas app lain (Phase 7) — user grant via system Settings -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Haptic tick saat baris lirik berganti. Tanpa ini Vibrator.vibrate()
         melempar SecurityException, dan runCatching di Haptics.tick menelannya,
         jadi setelan haptic di Settings diam-diam tidak pernah bekerja.
         Permission normal, tidak butuh grant runtime. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".SpotivibeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spotivibe">

        <!-- launchMode=singleTask wajib untuk redirect OAuth: tanpa ini,
             spotivibe://callback membuat instance MainActivity KEDUA di atas
             yang lama, bukan masuk lewat onNewIntent ke instance yang sudah
             memegang state auth. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Spotivibe"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Redirect Authorization Code + PKCE: spotivibe://callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${redirectSchemeName}"
                    android:host="${redirectHostName}" />
            </intent-filter>
        </activity>

        <!-- Buang LoginActivity milik Spotify Auth SDK dari manifest hasil merge.
             AAR-nya mendeklarasikan activity itu dengan intent-filter
             spotivibe://callback yang PERSIS SAMA dengan milik MainActivity,
             memakai manifest placeholder redirectSchemeName/redirectHostName
             yang kita isi sendiri. Akibatnya redirect auth memunculkan dialog
             pilihan berisi dua entri yang sama-sama berlabel "Spotivibe", dan
             kalau user memilih yang milik SDK, redirect-nya ditelan activity
             translucent yang langsung finish. onNewIntent kita tidak pernah
             jalan, jadi UI tertinggal di Connecting selamanya.

             Aman dihapus: sejak pindah ke Authorization Code + PKCE, tidak ada
             satu pun kode kita yang memakai AuthorizationClient. -->
        <activity
            android:name="com.spotify.sdk.android.auth.LoginActivity"
            tools:node="remove" />

        <!-- FileProvider untuk share lyric-card sebagai PNG ke other apps.
             Authority pakai BuildConfig.APPLICATION_ID supaya unik per build. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Foreground lyrics notification service. Type "specialUse" supaya
             system tidak claim sebagai media player + tidak hijack Spotify's
             Dynamic Island / lock screen media indicator. -->
        <service
            android:name=".service.SpotivibeNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Display synced lyrics of currently playing media from Spotify" />
        </service>

    </application>

</manifest>
