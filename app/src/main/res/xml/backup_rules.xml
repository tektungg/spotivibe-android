<?xml version="1.0" encoding="utf-8"?>
<!--
   Aturan backup untuk device di bawah API 31.

   DataStore Preferences kita (spotivibe_prefs) menyimpan access + refresh
   token Spotify dalam bentuk plaintext. Refresh token itu kredensial jangka
   panjang, jadi TIDAK boleh ikut terangkut ke cloud backup Google.

   Preference lain (tema, ukuran font, posisi overlay) memang tidak dibackup
   sekalian: nilainya sepele dan mengecualikan seluruh file jauh lebih aman
   daripada berharap file dipecah dengan benar.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
