<?xml version="1.0" encoding="utf-8"?>
<!--
   Aturan backup + device transfer untuk API 31+.

   Sama alasannya dengan backup_rules.xml: DataStore bisa masih memegang
   sisa refresh token Spotify dari versi lama sampai pembersihan jalan, jadi
   direktori datastore/ dikecualikan dari cloud-backup maupun device-transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
