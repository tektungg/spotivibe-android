<?xml version="1.0" encoding="utf-8"?>
<!--
    Lapisan foreground adaptive icon: lima baris lirik, satu menyala.

    Warna dan fillAlpha diambil PERSIS dari LyricLineState di LyricsList.kt:
      Active  accent #EC6A5C  alpha 1.00  tinggi 8
      Near    ink2   #C2BFB6  alpha 0.85  tinggi 6
      Far     ink3   #8A877F  alpha 0.55  tinggi 5
    Tinggi batang mengikuti skala tipografi yang sama (30/22/18 sp).

    Semua isi berada di dalam lingkaran r=33 berpusat di (54,54), zona aman
    adaptive icon. Sudut terjauh berjarak 30,4 dari pusat.

    Drawable ini dipakai juga sebagai lapisan <monochrome>. Di mode themed icon
    Android membuang warna tapi TETAP menghormati fillAlpha, jadi tiga tingkat
    kepekatannya bertahan. Baris aktif tetap terbaca karena dibedakan lewat
    ukuran, bukan cuma warna.

    Sumber: logo/spotivibe-icon-foreground.svg
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Far -->
    <path
        android:fillColor="#8A877F"
        android:fillAlpha="0.55"
        android:pathData="M41.5,27.5 H66.5 A2.5,2.5 0 0 1 66.5,32.5 H41.5 A2.5,2.5 0 0 1 41.5,27.5 Z" />

    <!-- Near -->
    <path
        android:fillColor="#C2BFB6"
        android:fillAlpha="0.85"
        android:pathData="M34,39 H74 A3,3 0 0 1 74,45 H34 A3,3 0 0 1 34,39 Z" />

    <!-- Active -->
    <path
        android:fillColor="#EC6A5C"
        android:pathData="M29,50 H79 A4,4 0 0 1 79,58 H29 A4,4 0 0 1 29,50 Z" />

    <!-- Near -->
    <path
        android:fillColor="#C2BFB6"
        android:fillAlpha="0.85"
        android:pathData="M36,63 H72 A3,3 0 0 1 72,69 H36 A3,3 0 0 1 36,63 Z" />

    <!-- Far -->
    <path
        android:fillColor="#8A877F"
        android:fillAlpha="0.55"
        android:pathData="M43.5,75.5 H64.5 A2.5,2.5 0 0 1 64.5,80.5 H43.5 A2.5,2.5 0 0 1 43.5,75.5 Z" />
</vector>
